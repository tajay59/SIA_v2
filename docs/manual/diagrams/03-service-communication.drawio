in fee · Pro Bono limits" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.3;entryX=1;entryY=0.5;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="availability (full qty per line?)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="access check (owner / organisation)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.7;" edge="1" parent="1" source="c6" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="email lists (cached 5 min)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c7" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;identity-svc&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="390" width="200" height="60" as="geometry"/></mxCell><mxCell id="c13" value="claim code once (codes never in Kafka)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontFamily=Helvetica;fontSize=12;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c7" target="c12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="Rules: never through nginx · 2 s timeout · max 2 retries on reads · circuit breaker · on failure return 503, never write partial data.&lt;br&gt;Everything else between services goes through Kafka; see diagram 04." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;fontFamily=Helvetica;fontSize=12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="920" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>