{
  "name": "@cimh/web-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Typed API clients generated from docs/api/*.openapi.yaml (the contract). Never edit src/generated by hand.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0"
  }
}
