{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order.shipped",
  "allOf": [
    {
      "type": "object",
      "required": [
        "eventId",
        "type",
        "version",
        "occurredAt",
        "correlationId",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "ULID; also the dedup key"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "customer",
            "carrier"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "customer": {
              "type": "string"
            },
            "carrier": {
              "type": "string",
              "enum": [
                "FEDEX",
                "DHL",
                "HAND"
              ]
            },
            "tracking": {
              "type": [
                "string",
                "null"
              ]
            },
            "notifyCustomer": {
              "type": "boolean"
            }
          }
        }
      }
    }
  ]
}
