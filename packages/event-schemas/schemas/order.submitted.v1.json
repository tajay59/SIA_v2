{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order.submitted",
  "allOf": [
    {
      "type": "object",
      "required": [
        "eventId",
        "type",
        "version",
        "occurredAt",
        "correlationId",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "ULID; also the dedup key"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "type",
            "customer",
            "lines"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "PAID",
                "PROBONO"
              ]
            },
            "customer": {
              "type": "string"
            },
            "organisationId": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "BBD",
                "USD",
                null
              ]
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "lineId",
                  "productId",
                  "qty"
                ],
                "properties": {
                  "lineId": {
                    "type": "string"
                  },
                  "productId": {
                    "type": "string"
                  },
                  "qty": {
                    "type": "integer"
                  },
                  "choice": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "CIMH",
                      "SUPPLIER",
                      null
                    ]
                  }
                }
              }
            },
            "splitFrom": {
              "type": [
                "string",
                "null"
              ],
              "description": "Sibling request id when a mixed cart was split"
            }
          }
        }
      }
    }
  ]
}
