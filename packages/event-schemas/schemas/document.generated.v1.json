{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.generated",
  "allOf": [
    {
      "type": "object",
      "required": [
        "eventId",
        "type",
        "version",
        "occurredAt",
        "correlationId",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "ULID; also the dedup key"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "fileId",
            "kind",
            "name",
            "mime",
            "size",
            "sha256"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "customer": {
              "type": "string",
              "description": "Requester account id (generated documents; notification-svc mails the agreement)"
            },
            "fileId": {
              "type": "string"
            },
            "number": {
              "type": "string",
              "description": "Invoice number of an invoice / commercial invoice"
            },
            "rev": {
              "type": "integer",
              "minimum": 1,
              "description": "Invoice / commercial invoice revision: 1 when first issued, higher for a corrected invoice that replaces the earlier one"
            },
            "notify": {
              "type": "object",
              "description": "Staff-built (or corrected) invoice / commercial invoice only: who notification-svc emails. Absent on automatic invoices",
              "properties": {
                "customer": {
                  "type": "boolean"
                },
                "staff": {
                  "type": "boolean"
                }
              }
            },
            "kind": {
              "type": "string",
              "enum": [
                "supplier_quote",
                "cimh_quote",
                "agreement",
                "signed_agreement",
                "invoice",
                "commercial_invoice",
                "probono_invoice",
                "payment_proof",
                "upload",
                "labels"
              ]
            },
            "quoteVersion": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Quote version of a generated agreement / CIMH quote, or of the quote a signed agreement was uploaded for"
            },
            "name": {
              "type": "string"
            },
            "mime": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
