{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.uploaded",
  "allOf": [
    {
      "type": "object",
      "required": [
        "eventId",
        "type",
        "version",
        "occurredAt",
        "correlationId",
        "payload"
      ],
      "properties": {
        "eventId": {
          "type": "string",
          "description": "ULID; also the dedup key"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string"
        },
        "actorId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    {
      "properties": {
        "payload": {
          "type": "object",
          "required": [
            "orderId",
            "fileId",
            "kind",
            "name",
            "mime",
            "size",
            "sha256"
          ],
          "properties": {
            "orderId": {
              "type": "string"
            },
            "customer": {
              "type": "string",
              "description": "Requester account id (generated documents; notification-svc mails the agreement)"
            },
            "fileId": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "supplier_quote",
                "cimh_quote",
                "agreement",
                "signed_agreement",
                "invoice",
                "commercial_invoice",
                "probono_invoice",
                "upload",
                "labels"
              ]
            },
            "name": {
              "type": "string"
            },
            "mime": {
              "type": "string"
            },
            "size": {
              "type": "integer"
            },
            "sha256": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
